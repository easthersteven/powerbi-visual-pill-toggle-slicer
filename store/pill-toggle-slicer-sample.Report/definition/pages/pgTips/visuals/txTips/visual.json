{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "txTips",
  "position": {
    "x": 40,
    "y": 96,
    "z": 0,
    "width": 900,
    "height": 460,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Keep the list short",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Pills are laid out horizontally, so this works best with two to six values - period, scenario, or unit switches. Long dimensions belong in a native slicer.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Set a default",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Turn on Default selection and name the value that should apply when the filter is cleared. It is reapplied automatically.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Avoid",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Binding a measure - the slicer takes a column. Also avoid fields with more than 100 distinct values; the visual caps its data reduction there.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
